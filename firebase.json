{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", "firestore.rules", "FIREBASE.md", "NOTIFICATIONS.md",
      "package.json", "package-lock.json", "node_modules/**", "notifier/**", "**/.*", "**/.*/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
